<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <stroke android:width="0.1dp" android:color="@color/colorBtnDarkGreen"/>
            <gradient android:startColor="@color/jx_btnStart" android:endColor="@color/jx_btnEnd" android:angle="90"/>
            <corners android:topLeftRadius="30dp" android:topRightRadius="30dp" android:bottomLeftRadius="30dp" android:bottomRightRadius="30dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/jx_btnEnd" android:endColor="@color/jx_btnStart" android:angle="90"/>
            <stroke android:width="0.1dp" android:color="@color/colorBtnStroke"/>
            <corners android:topLeftRadius="30dp" android:topRightRadius="30dp" android:bottomLeftRadius="30dp" android:bottomRightRadius="30dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="@color/jx_btnStart" android:endColor="@color/jx_btnEnd" android:angle="90"/>
            <stroke android:width="0.1dp" android:color="@color/colorBtnDarkGreen"/>
            <corners android:topLeftRadius="30dp" android:topRightRadius="30dp" android:bottomLeftRadius="30dp" android:bottomRightRadius="30dp"/>
        </shape>
    </item>
</selector>
