<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:background="@color/accent"
    android:layout_height="fill_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="@drawable/main_white_bg"
        android:layout_marginBottom="25dp"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"


            android:layout_weight="1.0"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:gravity="top"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:orientation="vertical"
                    android:layout_marginLeft="0dp"
                    android:layout_marginRight="0dp"
                    android:layout_marginTop="10dp"
                    android:visibility="visible"
                    android:layout_height="wrap_content">
                    <FrameLayout
                        android:layout_width="fill_parent"
                        android:gravity="center"
                        android:layout_margin="0dp"
                        android:visibility="visible"
                        android:layout_height="155dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:layout_marginRight="10dip"
                            android:layout_marginTop="0dp"
                            android:text="Rk_Build-2"
                            android:visibility="visible"
                            android:textColor="#000000"
                            android:textSize="6dp"
                            android:typeface="serif"
                            android:textStyle="bold" />
                        <ListView
                            android:visibility="visible"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="0dp"
                            android:layout_width="match_parent"
                            android:layout_height="150dp" />


                        <RelativeLayout
                            android:id="@+id/graph"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp">

                            <fragment
                                android:name="com.alinaj.dev.fragment.GraphFragment"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                tools:layout="@layout/graph" />

                        </RelativeLayout>


                        <LinearLayout
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="93dp"
                                android:layout_height="93dp"
                                android:id="@+id/banner"
                                android:layout_marginBottom="5dp"
                                android:src="@drawable/ic_launcher"
                                android:layout_gravity="center"/>

                            <TextView
                                android:textAppearance="?android:textAppearanceSmall"
                                android:textSize="20.0sp"
                                android:typeface="serif"
                                android:textStyle="bold"
                                android:textColor="@color/accent"
                                android:gravity="center"
                                android:layout_gravity="center"
                                android:paddingLeft="10.0dip"
                                android:paddingRight="10.0dip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="0.0dip"
                                android:text="@string/app"
                                android:maxLines="1"
                                android:shadowColor="#ff000000"
                                android:shadowDx="1.0"
                                android:shadowDy="1.0"
                                android:shadowRadius="1.5"
                                android:layout_alignParentBottom="true"
                                android:layout_centerInParent="true"
                                android:scaleX="1.1"
                                android:scaleY="0.9" />


                        </LinearLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:id="@+id/linegraphView"
                            android:layout_gravity="bottom"
                            android:layout_width="fill_parent"
                            android:layout_height="0.8dp"
                            android:layout_marginBottom="15dp"
                            android:background="#E3E0E2"
                            android:visibility="visible"
                            android:layout_marginRight="20dp"
                            android:layout_marginLeft="20dp"/>
                    </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="30dp"
                    android:layout_marginTop="0dp"
                    android:visibility="visible"
                    android:layout_gravity="bottom"
                    android:layout_marginRight="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cloud_download"
                            app:tint="@color/accent" />
                        <TextView
                            android:id="@+id/bytes_in"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:text="0 KB"
                            android:textColor="#FF222122"
                            android:textSize="10dp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tunnel_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIRECT"
                        android:textColor="#FF222122"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="visible" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="right|center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/bytes_out"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:text="0 KB"
                            android:gravity="right"
                            android:textColor="#FF222122"
                            android:textSize="10dp"
                            android:textStyle="bold" />
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cloud_upload"
                            app:tint="@color/accent" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:gravity="center"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="0.2dip">

                    <TextView
                        android:id="@+id/status"
                        android:typeface="serif"
                        android:textAppearance="?android:textAppearanceSmall"
                        android:textSize="18.0sp"
                        android:textStyle="bold"
                        android:textColor="@color/red"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:paddingLeft="10.0dip"
                        android:paddingRight="10.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0.0dip"
                        android:text="Disconnected"
                        android:maxLines="1"
                        android:shadowColor="#ff000000"
                        android:shadowDx="1.0"
                        android:shadowDy="1.0"
                        android:shadowRadius="1.5"
                        android:layout_alignParentBottom="true"
                        android:layout_centerInParent="true"
                        android:scaleX="1.1"
                        android:scaleY="0.9" />

                </FrameLayout>
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="0dp"
                        android:text="Config Version : "
                        android:textColor="#FF222122"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/config_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0"
                        android:textColor="#FF222122"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="1dp"
                        android:layout_height="15dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:background="#79787878" />

                    <TextView
                        android:id="@+id/iplocal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IP : 127.0.0.1"
                        android:textColor="#FF222122"
                        android:textSize="10sp" />

                    <LinearLayout
                        android:layout_width="1dp"
                        android:layout_height="15dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:background="#79787878" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="0dp"
                        android:text="Time:Speed "
                        android:textColor="#FF222122"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0.0.0"
                        android:textColor="#FF222122"
                        android:textSize="10sp" />


                </LinearLayout>
                <FrameLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/jx_card_frame"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="5dp">

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="55dp"
                        android:layout_margin="5dp"
                        android:background="@drawable/jx_radius"
                        android:gravity="clip_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/profile"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|left"
                            android:layout_marginLeft="10dp"
                            android:background="#00000000"
                            android:layout_marginRight="5dp"
                            android:drawSelectorOnTop="true"
                            android:dropDownVerticalOffset="45.0dip"
                            android:spinnerMode="dialog" />
                    </LinearLayout>

                    <TextView
                        android:textAppearance="?android:textAppearanceSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/spinner_bg_title"
                        android:paddingLeft="3dp"
                        android:gravity="center"
                        android:paddingRight="3dp"
                        android:paddingBottom="1dp"
                        android:text="LOCATION"
                        android:textColor="@color/accent"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:typeface="serif" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="0dp"
                    android:background="@drawable/jx_card_frame"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="5dp">

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:minHeight="55dp"
                        android:background="@drawable/jx_radius"
                        android:gravity="clip_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/network_spin"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center|left"
                            android:layout_marginLeft="10dp"
                            android:background="#00000000"
                            android:layout_weight="1"
                            android:drawSelectorOnTop="true"
                            android:dropDownVerticalOffset="45.0dip"
                            android:layout_marginRight="5dp"
                            android:spinnerMode="dialog" />

                    </LinearLayout>
                    <TextView
                        android:textAppearance="?android:textAppearanceSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="15dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/spinner_bg_title"
                        android:paddingLeft="3dp"
                        android:gravity="center"
                        android:paddingRight="3dp"
                        android:paddingBottom="1dp"
                        android:text="NETWORK"
                        android:textColor="@color/accent"
                        android:textSize="7sp"
                        android:textStyle="bold"
                        android:typeface="serif" />

                </FrameLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:layout_marginLeft="10dp"
                    android:visibility="visible"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:orientation="vertical">
                        <Button
                            android:id="@+id/connect"
                            android:layout_width="fill_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/button_connect"
                            android:text="START"
                            android:outlineProvider="none"
                            android:gravity="center"
                            android:textColor="@color/red"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:topLeftRadius="360dp"
                            android:topRightRadius="360dp"
                            android:bottomLeftRadius="360dp"
                            android:bottomRightRadius="360dp"
                            app:backgroundTint="@null" />



                        <Button
                            android:id="@+id/disconnect"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:background="@drawable/button_disconnect"
                            android:text="STOP"
                            android:outlineProvider="none"
                            android:gravity="center"
                            app:backgroundTint="@null"
                            android:textColor="#2E8E0B"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <com.alinaj.dev.view.CircleProgressBar
                        android:id="@+id/custom_progressBar"
                        android:layout_width="135dp"
                        android:layout_height="135dp"
                        app:progress="0"
                        app:progressBarThickness="9dp"
                        app:progressbarColor="@color/red" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="12dp"
                    android:layout_marginTop="16dp"
                    android:textStyle="bold"
                    android:text="Account Expiration Details"/>
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="5dp"
                    android:visibility="visible"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="0dip"
                        android:text="Date: "
                        android:textSize="12dp"
                        android:textColor="#000000"
                        android:textStyle="normal" />

                    <TextView
                        android:id="@+id/date_text"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:textSize="12dp"
                        android:layout_marginBottom="0dip"
                        android:text="--/--/--"
                        android:textColor="#000000"
                        android:textStyle="normal" />
                    <LinearLayout
                        android:layout_width="1dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:background="#000000" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="0dip"
                        android:text="Time: "
                        android:textSize="12dp"
                        android:textColor="#000000"
                        android:textStyle="normal" />
                    <TextView
                        android:id="@+id/time_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="0dip"
                        android:text="--/--"
                        android:textSize="12dp"
                        android:textColor="#000000"
                        android:textStyle="normal" />
                    <LinearLayout
                        android:layout_width="1dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:background="#000000" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="0dip"
                        android:text="Expiry: "
                        android:textSize="12dp"
                        android:textColor="#000000"
                        android:textStyle="normal" />
                    <TextView
                        android:id="@+id/expire_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="0dip"
                        android:text="-- Days Left"
                        android:textSize="12dp"
                        android:textColor="#000000"
                        android:textStyle="normal" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/bannerImage"
                    android:visibility="gone"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="5dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"/>

                <LinearLayout
                    android:id="@+id/options_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/custom_add_tweaks"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/accent_color" />

                    <LinearLayout
                        android:layout_width="1dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:background="@color/accent_color" />

                    <ImageView
                        android:id="@+id/custom_edit_tweaks"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_edit_tweaks"
                        android:visibility="gone"
                        app:tint="@color/accent_color" />

                    <LinearLayout
                        android:layout_width="1dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:visibility="gone"
                        android:background="@color/accent_color" />

                    <ImageView
                        android:id="@+id/custom_delete_tweaks"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/accent_color" />

                    <LinearLayout
                        android:layout_width="1dp"
                        android:layout_height="10dp"
                        android:layout_marginLeft="10dp"
                        android:layout_marginRight="10dp"
                        android:background="@color/accent_color" />

                    <Switch
                        android:id="@+id/custom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginRight="10dp"
                        android:text="Custom"
                        android:textColor="#ff000000"
                        android:textSize="12dp"
                        android:textStyle="bold" />
                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/adView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginTop="5dp">
                </RelativeLayout>

            </LinearLayout>
        </ScrollView>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:layout_gravity="center|bottom"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:visibility="visible"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/b_update"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:background="@drawable/rlb_card_top_shape"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_box_download"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update"
                android:textColor="#ff000000" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/b_logout"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:background="@drawable/rlb_card_top_shape"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:padding="2dp"
                android:src="@drawable/account_login"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textColor="#ff000000" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/b_tweaks"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_weight="1.0"
            android:background="@drawable/rlb_card_top_shape"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/tweakers"
                app:tint="@color/accent_color"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tweaks"
                android:textColor="#ff000000"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/b_privacy"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:background="@drawable/rlb_card_top_shape"
            android:gravity="center"
            android:visibility="gone"
            android:orientation="vertical">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/privacy"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy"
                android:textColor="#ff000000" />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/c_exit"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_weight="1.0"
            android:background="@drawable/rlb_card_top_shape"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_exit"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exit"
                android:textColor="#ff000000" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>



